# YouTube upload PoC (see POC.md). Unset or anything other than
# "integration" keeps /upload-poc in mock mode — no credentials needed and no
# request ever reaches Google. Setting it to "integration" additionally
# requires the three vars below; do not put real values in this file.
YOUTUBE_UPLOAD_MODE=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
